{
  "version": 1,
  "status": "draft",
  "comment": "",
  "summary": "A full refund is auto-approved when any of these is true:\n\n- The refund amount is $30 or less.\n- The customer changed their mind, and it was delivered within 14 days.\n- The order arrived damaged, and the refund amount is over $50.\n- The order never arrived.",
  "allow": [
    {
      "id": "small_stuff_30",
      "action": "approve_full",
      "all_of": [
        {
          "when": {
            "amount_usd_lte": 30
          }
        }
      ]
    },
    {
      "id": "changed_mind_14d",
      "action": "approve_full",
      "all_of": [
        {
          "when": {
            "stated_reason": "changed_mind",
            "days_since_delivery_lte": 14
          }
        }
      ]
    },
    {
      "id": "arrived_damaged_photo_50",
      "action": "approve_full",
      "all_of": [
        {
          "when": {
            "stated_reason": "arrived_damaged",
            "amount_usd_gt": 50
          }
        }
      ]
    },
    {
      "id": "never_arrived_signature",
      "action": "approve_full",
      "all_of": [
        {
          "when": {
            "stated_reason": "never_arrived"
          }
        }
      ]
    }
  ]
}
